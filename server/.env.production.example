# Copy to .env on the server (never commit real secrets)

# Supabase session pooler (recommended for Node/Express on shared host)
DATABASE_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&connection_limit=5"
DIRECT_URL="postgresql://postgres.YOUR_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

PORT=4000
HOST=0.0.0.0

# Exact frontend origin(s), comma-separated if needed
CORS_ORIGIN="https://votredomaine.tn,https://www.votredomaine.tn"

JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
