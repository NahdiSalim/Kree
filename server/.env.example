# Runtime DB (session pooler is most stable for Express on Windows/IPv4)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&connection_limit=5"

# Migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# Alternative: transaction pooler for Prisma Client
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&sslmode=require"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
