# TunisRent SPA — Apache (cPanel / OxaHost)
# Ensures BrowserRouter deep links ( /maisons/:id, /dashboard, … ) serve index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep real files/folders (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → SPA entry
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: force HTTPS (uncomment if SSL is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
